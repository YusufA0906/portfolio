# Copy to yp/.env and fill in. yp/.env is git-ignored — never commit it.
#
# Local development: just DJANGO_DEBUG=1 is enough.
# Live server: leave DJANGO_DEBUG unset (debug off) and set the rest.

# DJANGO_DEBUG=1

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=www.yusufali.dev,yusufali.dev
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.yusufali.dev,https://yusufali.dev
